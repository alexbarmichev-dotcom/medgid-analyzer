{
  "tests": [
    {
      "name": "options preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "no auth token",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "invalid auth token",
      "method": "GET",
      "path": "/",
      "headers": {"X-Authorization": "invalid.token"},
      "expectedStatus": 401
    },
    {
      "name": "create feedback with valid data",
      "method": "POST",
      "path": "/?resource=feedback",
      "body": {
        "type": "question",
        "subject": "Как работает расшифровка?",
        "message": "Расскажите подробнее, как именно работает расшифровка анализов в приложении."
      },
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "reject too short feedback message",
      "method": "POST",
      "path": "/?resource=feedback",
      "body": {
        "type": "question",
        "subject": "Тест",
        "message": "Коротко"
      },
      "expectedStatus": 400
    },
    {
      "name": "reject invalid feedback type",
      "method": "POST",
      "path": "/?resource=feedback",
      "body": {
        "type": "unknown",
        "subject": "Тест",
        "message": "Это сообщение содержит более двадцати символов текста."
      },
      "expectedStatus": 400
    },
    {
      "name": "list feedback",
      "method": "GET",
      "path": "/?resource=feedback",
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "admin without password",
      "method": "GET",
      "path": "/?resource=admin&admin=payments",
      "expectedStatus": 401
    },
    {
      "name": "admin wrong password",
      "method": "GET",
      "path": "/?resource=admin&admin=payments",
      "headers": {"X-Admin-Password": "wrong-password-xyz"},
      "expectedStatus": 401
    },
    {
      "name": "list approved reviews",
      "method": "GET",
      "path": "/?resource=reviews",
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "create review with valid data",
      "method": "POST",
      "path": "/?resource=reviews",
      "body": {
        "author": "Тестовый пользователь",
        "role": "Общий анализ крови",
        "rating": 5,
        "text": "Отличный сервис, всё понятно и быстро расшифровали мои анализы крови."
      },
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "reject review without author",
      "method": "POST",
      "path": "/?resource=reviews",
      "body": {
        "author": "",
        "rating": 5,
        "text": "Отличный сервис, всё понятно и быстро расшифровали мои анализы крови."
      },
      "expectedStatus": 400
    },
    {
      "name": "reject review with bad rating",
      "method": "POST",
      "path": "/?resource=reviews",
      "body": {
        "author": "Тест",
        "rating": 9,
        "text": "Отличный сервис, всё понятно и быстро расшифровали мои анализы крови."
      },
      "expectedStatus": 400
    },
    {
      "name": "reject too short review text",
      "method": "POST",
      "path": "/?resource=reviews",
      "body": {
        "author": "Тест",
        "rating": 5,
        "text": "Коротко"
      },
      "expectedStatus": 400
    },
    {
      "name": "review moderation without admin password",
      "method": "PATCH",
      "path": "/?resource=reviews&id=1",
      "body": {"status": "approved"},
      "expectedStatus": 401
    }
  ]
}