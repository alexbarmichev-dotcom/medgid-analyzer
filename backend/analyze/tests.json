{
  "tests": [
    {
      "name": "options preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "no action specified",
      "method": "POST",
      "path": "/",
      "headers": {"X-Authorization": "invalid.token"},
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "create_payment without auth",
      "method": "POST",
      "path": "/?action=create_payment",
      "body": {"gender": "m", "age": "30", "files": []},
      "expectedStatus": 401
    },
    {
      "name": "create_payment with invalid token",
      "method": "POST",
      "path": "/?action=create_payment",
      "headers": {"X-Authorization": "invalid.token"},
      "body": {"gender": "m", "age": "30", "files": []},
      "expectedStatus": 401
    },
    {
      "name": "check_payment without auth",
      "method": "POST",
      "path": "/?action=check_payment",
      "body": {"paymentId": "test"},
      "expectedStatus": 401
    },
    {
      "name": "upload_start without auth",
      "method": "POST",
      "path": "/?action=upload_start",
      "body": {"files": [{"name": "a.jpg", "type": "image/jpeg", "size": 100}]},
      "expectedStatus": 401
    },
    {
      "name": "resume unknown session",
      "method": "POST",
      "path": "/?action=resume",
      "body": {"sessionId": "00000000-0000-0000-0000-000000000000"},
      "expectedStatus": 404
    },
    {
      "name": "cleanup runs or skips",
      "method": "POST",
      "path": "/?action=cleanup",
      "body": {},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "incomplete without auth",
      "method": "POST",
      "path": "/?action=incomplete",
      "body": {},
      "expectedStatus": 401
    },
    {
      "name": "free without auth",
      "method": "POST",
      "path": "/?action=free",
      "body": {"gender": "m", "age": "30", "files": []},
      "expectedStatus": 401
    }
  ]
}