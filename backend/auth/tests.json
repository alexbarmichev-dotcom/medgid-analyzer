{
  "tests": [
    {
      "name": "options preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "bad email format on send_code",
      "method": "POST",
      "path": "/",
      "body": {"action": "send_code", "email": "not-an-email"},
      "expectedStatus": 400
    },
    {
      "name": "verify_code without code",
      "method": "POST",
      "path": "/",
      "body": {"action": "verify_code", "email": "test@example.com"},
      "expectedStatus": 400
    },
    {
      "name": "unknown action",
      "method": "POST",
      "path": "/",
      "body": {"action": "unknown"},
      "expectedStatus": 400
    }
  ]
}
