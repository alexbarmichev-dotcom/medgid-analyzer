{
  "tests": [
    {
      "name": "options preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "bad phone format on send_code",
      "method": "POST",
      "path": "/",
      "body": {"action": "send_code", "phone": "123"},
      "expectedStatus": 400
    },
    {
      "name": "verify_code without code",
      "method": "POST",
      "path": "/",
      "body": {"action": "verify_code", "phone": "79991234567"},
      "expectedStatus": 400
    },
    {
      "name": "unknown action",
      "method": "POST",
      "path": "/",
      "body": {"action": "unknown"},
      "expectedStatus": 400
    }
  ]
}
