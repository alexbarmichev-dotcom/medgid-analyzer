{
  "tests": [
    {
      "name": "options preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "bad email format on send_code",
      "method": "POST",
      "path": "/",
      "body": {"action": "send_code", "email": "not-an-email"},
      "expectedStatus": 400
    },
    {
      "name": "verify_code without code",
      "method": "POST",
      "path": "/",
      "body": {"action": "verify_code", "email": "test@example.com"},
      "expectedStatus": 400
    },
    {
      "name": "unknown action",
      "method": "POST",
      "path": "/",
      "body": {"action": "unknown"},
      "expectedStatus": 400
    },
    {
      "name": "anonymous without deviceId",
      "method": "POST",
      "path": "/",
      "body": {"action": "anonymous", "deviceId": ""},
      "expectedStatus": 400
    },
    {
      "name": "password_login with bad password format",
      "method": "POST",
      "path": "/",
      "body": {"action": "password_login", "login": "testuser", "password": "abcd"},
      "expectedStatus": 400
    },
    {
      "name": "password_login with bad login format",
      "method": "POST",
      "path": "/",
      "body": {"action": "password_login", "login": "a", "password": "1234"},
      "expectedStatus": 400
    }
  ]
}