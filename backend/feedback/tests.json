{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Create feedback with valid data",
      "method": "POST",
      "path": "/",
      "body": {
        "type": "question",
        "subject": "Как работает расшифровка?",
        "message": "Расскажите подробнее, как именно работает расшифровка анализов в приложении."
      },
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Reject too short message",
      "method": "POST",
      "path": "/",
      "body": {
        "type": "question",
        "subject": "Тест",
        "message": "Коротко"
      },
      "expectedStatus": 400
    },
    {
      "name": "Reject invalid type",
      "method": "POST",
      "path": "/",
      "body": {
        "type": "unknown",
        "subject": "Тест",
        "message": "Это сообщение содержит более двадцати символов текста."
      },
      "expectedStatus": 400
    },
    {
      "name": "List feedback",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    }
  ]
}
