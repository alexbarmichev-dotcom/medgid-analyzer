{
  "tests": [
    {
      "name": "options preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "status without auth",
      "method": "GET",
      "path": "/?resource=status",
      "expectedStatus": 401
    },
    {
      "name": "status with invalid token",
      "method": "GET",
      "path": "/?resource=status",
      "headers": {"X-Authorization": "invalid.token"},
      "expectedStatus": 401
    },
    {
      "name": "ask without auth",
      "method": "POST",
      "path": "/?action=ask",
      "body": {"question": "test"},
      "expectedStatus": 401
    },
    {
      "name": "unknown GET resource without auth",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    }
  ]
}